# Application
APP_URL=http://localhost:3000
NODE_ENV=development
SESSION_COOKIE_NAME=reviewer_session
SESSION_TTL_DAYS=30
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Neon Postgres (use the pooled URL for the web app)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# GitHub Reviewer App (repository access + user authorization)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Vercel AI Gateway / AI SDK
AI_GATEWAY_API_KEY=
AI_REVIEW_MODEL=openai/gpt-5.4
AI_SUMMARY_MODEL=openai/gpt-5.4-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Inngest. Set INNGEST_DEV=1 locally when using the dev server.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional operational controls
LOG_LEVEL=info
MAX_INDEX_FILE_BYTES=500000
MAX_PR_CHANGED_LINES=5000
REVIEW_CONFIDENCE_THRESHOLD=0.78
